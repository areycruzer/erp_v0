# Test Environment Configuration
NODE_ENV=test
PORT=3002

# Test Database Configuration
DATABASE_URL=postgresql://hajiri_user:hajiri_password@localhost:5432/hajiri_test_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hajiri_test_db
DB_USER=hajiri_user
DB_PASSWORD=hajiri_password

# JWT Configuration
JWT_SECRET=test-jwt-secret-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=test-encryption-key-32-chars-long

# Redis Configuration
REDIS_URL=redis://localhost:6379/1